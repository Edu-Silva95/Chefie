<% if flash.any? %>
  <div class="flash-container" role="status" aria-live="polite">
    <% flash.each do |type, message| %>
      <% next if message.blank? %>
      <div class="<%= flash_toast_class(type, message) %>" data-flash-timeout="5000">
        <%= message %>
      </div>
    <% end %>
  </div>
<% end %>
