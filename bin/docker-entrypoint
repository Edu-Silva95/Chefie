#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ] && [ -z "${DISABLE_JEMALLOC}" ] && [ -f /usr/lib/*/libjemalloc.so.2 ]; then
  export LD_PRELOAD="$(echo /usr/lib/*/libjemalloc.so.2)"
fi

# If running the rails server then create or migrate existing database
if [ -d "/data" ]; then
  mkdir -p "${RAILS_STORAGE_PATH:-/data/storage}"
  chown rails:rails "/data" || true
  chown rails:rails "${RAILS_STORAGE_PATH:-/data/storage}" || true
fi

if [ "${1}" == "./bin/rails" ] && [ "${2}" == "server" ]; then
  gosu rails:rails ./bin/rails db:prepare
fi

exec gosu rails:rails "${@}"
